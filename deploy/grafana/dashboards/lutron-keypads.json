{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 20, "spanNulls": true }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "lutron_device_led{area=~\"$area\"}",
          "legendFormat": "{{area}} / {{device_name}} / {{led_name}}",
          "refId": "A"
        }
      ],
      "title": "Keypad LED state",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "decimals": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "OFF" }, "1": { "text": "ON" } } }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 10 },
      "id": 2,
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "targets": [
        {
          "expr": "lutron_device_led{area=~\"$area\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "LED state now",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "area": "Area",
              "device_name": "Keypad",
              "led_name": "Button",
              "Value": "State"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "schemaVersion": 39,
  "tags": ["lutron", "qs", "keypad"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(lutron_device_led, area)",
        "includeAll": true,
        "label": "Area",
        "multi": true,
        "name": "area",
        "query": {
          "qryType": 1,
          "query": "label_values(lutron_device_led, area)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Lutron QS keypads",
  "uid": "lutron-qs-keypads",
  "version": 1
}
