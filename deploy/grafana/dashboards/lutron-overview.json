{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "watt", "decimals": 1 },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(lutron_zone_watts{area=~\"$area\"})",
          "refId": "A"
        }
      ],
      "title": "Total watts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "count(lutron_zone_level{area=~\"$area\"} > 0)",
          "refId": "A"
        }
      ],
      "title": "Zones above 0%",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "lutron_info",
          "legendFormat": "{{processor_type}} {{firmware_version}} design {{design_version}}",
          "refId": "A"
        }
      ],
      "title": "Processor",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "watt", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "id": 4,
      "targets": [
        {
          "expr": "lutron_zone_watts{area=~\"$area\"}",
          "legendFormat": "{{area}} / {{zone_name}}",
          "refId": "A"
        }
      ],
      "title": "Zone watts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "id": 5,
      "targets": [
        {
          "expr": "lutron_zone_level{area=~\"$area\"}",
          "legendFormat": "{{area}} / {{zone_name}}",
          "refId": "A"
        }
      ],
      "title": "Zone level",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "max": 1 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 22 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [{ "expr": "lutron_scrape_success", "refId": "A" }],
      "title": "Last scrape succeeded",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 }, "overrides": [] },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 22 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [{ "expr": "lutron_scrape_duration_seconds", "refId": "A" }],
      "title": "Last scrape duration",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "dateTimeFromNow" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 22 },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [{ "expr": "lutron_last_success_timestamp_seconds * 1000", "refId": "A" }],
      "title": "Last successful scrape",
      "type": "stat"
    }
  ],
  "schemaVersion": 39,
  "tags": ["lutron", "qs"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(lutron_zone_level, area)",
        "includeAll": true,
        "label": "Area",
        "multi": true,
        "name": "area",
        "query": {
          "qryType": 1,
          "query": "label_values(lutron_zone_level, area)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Lutron QS overview",
  "uid": "lutron-qs-overview",
  "version": 1
}
